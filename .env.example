# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Optional server GitHub token for public discovery without user OAuth
GITHUB_TOKEN=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bountyos

# Session signing — generate a long random secret
SESSION_SECRET=

# AI provider (OpenAI-compatible). Leave empty to use deterministic analysis only.
AI_PROVIDER=compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

NEXT_PUBLIC_APP_URL=http://localhost:3000
